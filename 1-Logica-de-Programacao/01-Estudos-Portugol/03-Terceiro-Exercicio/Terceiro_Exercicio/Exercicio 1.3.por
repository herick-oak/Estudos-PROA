programa {
  funcao inicio() {
    // 1 - Crie uma bomba relógio (usando somente código - para deixar claro!) cuja contagem regressiva vá de 30 a 0. No final da repetição escreva "EXPLOSÃO".
    
    escreva("BOMBA RELÓGIO ATIVADA!\n")
    escreva("Contagem regressiva:\n")

    inteiro contador = 30

    enquanto(contador >= 0){
      escreva(contador, "\n")
      contador-- 
    }
    
    escreva("Explosão!!!!!!!!!!!!!!!!\n")
    escreva("HAHAHAHAHAHAHAHHAHAHAHAHAHAHAHAHAHHAHAHA")

  }
}
