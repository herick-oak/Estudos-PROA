programa {
  funcao inicio() {
    // 5.  Faça um programa que leia 6 valores informados pelo usuário, calcule, exiba os números informados e escreva a média aritmética desses valores lidos.

    escreva("Escreva o primeiro valor: ")
    inteiro valor1 
    leia(valor1)
    escreva("Escreva o segundo valor: ")
    inteiro valor2
    leia(valor2)
    escreva("Escreva o terceiro valor: ")
    inteiro valor3
    leia(valor3)
    escreva("Escreva o quarto valor: ")
    inteiro valor4 
    leia(valor4)
    escreva("Escreva o quinto valor: ")
    inteiro valor5
    leia(valor5)
    escreva("Escreva o sexta valor: ")
    inteiro valor6
    leia(valor6)

    inteiro calculo = valor1 + valor2 + valor3 + valor4 + valor5 + valor6
    inteiro media = calculo / 6

    escreva(media)
  





  }
}
